# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon (publishable) key from Settings -> API.
# Safe to expose: Row Level Security is what constrains access, and the `anon`
# role is granted nothing on the pms_ tables. Every read happens as a signed-in
# user.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service_role key bypasses RLS entirely and must NEVER be given a
# NEXT_PUBLIC_ prefix or otherwise reach the browser. The app does not use it;
# it is only needed for running migrations or admin scripts from a trusted
# machine. Leave unset unless you are doing that.
# SUPABASE_SERVICE_ROLE_KEY=
